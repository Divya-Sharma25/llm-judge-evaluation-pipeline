GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Two different model families on Groq -> approximates cross-family judging
# (self-enhancement bias mitigation) without needing a second provider.
GENERATOR_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=openai/gpt-oss-20b

MAX_JSON_REPAIR_ATTEMPTS=2
CONSISTENCY_RUNS=3
PASS_THRESHOLD=3.5
RESULTS_DIR=results
